rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Cross-service read: requires the "Firebase Rules Firestore Service
    // Agent" IAM role granted to Storage's service agent. In practice this
    // grant repeatedly failed to take effect for this project (tried three
    // times, including via the CLI's own prompt) -- still used for read
    // below, but no longer load-bearing for write; see the match block.
    function noteDoc(noteId) {
      return firestore.get(/databases/(default)/documents/notes/$(noteId)).data;
    }

    function canAccessNote(noteId) {
      return request.auth != null
        && !noteDoc(noteId).get('deleting', false)
        && (request.auth.uid == noteDoc(noteId).userId
            || request.auth.uid in noteDoc(noteId).get('sharedWith', []));
    }

    function activeAccount() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/accountDeletionLocks/$(request.auth.uid))
            || request.time >= firestore.get(/databases/(default)/documents/accountDeletionLocks/$(request.auth.uid)).data.expiresAt);
    }

    // Audio belongs to a note, not a user-specific path. Only the note's
    // creator may replace it; collaborators can still read it via
    // canAccessNote above.
    match /notes/{noteId}/sync/{syncId}/audio/{fileName} {
      allow read: if activeAccount() && canAccessNote(noteId);
      allow create, update: if activeAccount()
        && !noteDoc(noteId).get('deleting', false)
        && request.auth.uid == noteDoc(noteId).userId
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if activeAccount() && request.auth.uid == noteDoc(noteId).userId;
    }
  }
}
