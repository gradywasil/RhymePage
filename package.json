{
  "name": "rhymepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-legal-pages.mjs && tsc --noEmit && vite build",
    "legal:build": "node scripts/build-legal-pages.mjs",
    "build:android": "tsc --noEmit && vite build --mode android --outDir dist-android && node scripts/prepare-android.mjs",
    "build:android:emulator": "tsc --noEmit && vite build --mode android-emulator --outDir dist-android && node scripts/prepare-android.mjs",
    "android:emulator": "npm run build:android:emulator && node scripts/build-android.mjs --emulator",
    "android:sync": "npm run build:android && cap sync android",
    "android:debug": "npm run android:sync && node scripts/build-android.mjs",
    "android:bundle": "node scripts/release-preflight.mjs --build-only && npm run android:sync && node scripts/build-android.mjs --bundle",
    "android:release-check": "node scripts/release-preflight.mjs",
    "android:art": "node scripts/make-android-art.mjs",
    "test:firebase": "node scripts/test-firebase-emulators.mjs",
    "android:open": "cap open android",
    "play:setup": "node scripts/play.mjs install",
    "play:check": "node scripts/play.mjs check",
    "play:upload": "node scripts/play.mjs internal",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@heroicons/react": "^2.2.0",
    "@huggingface/transformers": "^4.2.0",
    "firebase": "^12.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "txtanime.js": "^1.7.0",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "daisyui": "^5.7.19",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true
  }
}
